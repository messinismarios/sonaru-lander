---
/**
 * The Sonaru wordmark - "Sonaru", set in the logotype face.
 *
 * Set in **Outfit at 600, tracked −0.03em**, in one colour. Chosen by the owner over
 * Satoshi and three other rounder candidates (Figtree, Plus Jakarta Sans, Nunito) with the
 * word set in each - the rounder, fully geometric face against the site's tighter one.
 *
 * It is subset to the six letters of the word (~2 KB), so the second face costs almost
 * nothing. Provisional alongside the mark: when the logotype is finished it becomes
 * outlines and stops being a loaded font at all.
 *
 * `face` overrides it, which is how the alternatives were compared.
 */
interface Props {
  /** `lockup` places the mark beside the word; `word` is the wordmark alone. */
  readonly variant?: 'lockup' | 'word';
  readonly size?: number;
  /** CSS font-family override. Defaults to the logotype face. */
  readonly face?: string | undefined;
  readonly class?: string | undefined;
}

import SonaruMark from './SonaruMark.astro';

const { variant = 'lockup', size = 28, face, class: className } = Astro.props;
---

<span
  class:list={['wordmark', className]}
  data-variant={variant}
  style={`--wm-size: ${size}px;${face === undefined ? '' : ` --wm-face: ${face};`}`}
>
  {variant === 'lockup' && <SonaruMark size={Math.round(size * 1.15)} />}
  <span class="word">Sonaru</span>
</span>

<style>
  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: 0.42em;
    font-size: var(--wm-size);
  }
  /*
   * One colour for the whole word. The brand colour lives on the mark's wave (owner, Gate C
   * rev 13), the element that carries the meaning.
   */
  .word {
    font-family: var(--wm-face, var(--font-logotype));
    font-weight: 600;
    font-size: 1em;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--color-white);
  }
</style>
