---
/**
 * One full-screen release - the web mirror of `SonaruFeatures/Feed/ReleasePlayerCard.swift`.
 *
 * The order of parts is the Swift view's order, so a reader can map site → app: the
 * `new` + kind header with its info glyph, the artwork, the artist chip, then the title,
 * date, scrub bar and transport row, then the bottom bar. Proportions come from the same
 * arithmetic the original uses against the screen height - `min(18, H * 0.022)` there is
 * `min(18px, 2.2cqh)` here, resolved against the container query context `Device.astro`
 * opens.
 *
 * **The title is the release title alone** (owner, 2026-09-11). It used to read
 * `artist - title`, which named the artist twice within 30px of itself: the chip directly
 * above it is already the artist, and on real covers - `Porter Robinson - SMILE! :D` - the
 * repetition was the widest line on the screen and the first thing to wrap.
 *
 * Two deliberate departures, both because this is a marketing surface rather than a
 * running app: the session affordances in the app's bottom bar (log out, connect Apple
 * Music) are omitted, and the transport controls are rendered inert. The transport is
 * still shown because it is truthful - in the app those buttons move between tracks of a
 * multi-track release and never advance the feed.
 */
import { Image, Picture } from 'astro:assets';
import { catalogue } from '../../i18n';

interface Props {
  readonly artist: string;
  /**
   * The artist's photograph for the chip, when the showcase has one. Undefined leaves the
   * chip's blank disc, which is what every card wore before act one brought artist
   * photography into the repo - see `FeedScreen.astro`.
   */
  readonly artistPhoto?: ImageMetadata | undefined;
  readonly title: string;
  readonly kind: 'single' | 'ep' | 'album';
  readonly releaseDate: string;
  readonly duration: number;
  readonly artwork: ImageMetadata;
  /** The count the app's bottom label carries, or null on the last card. */
  readonly unseenCount: number | null;
  /**
   * Whether this is the release on screen at first paint. It loads eagerly at high
   * priority; the rest are lazy, because a cover that is one screen down inside a masked
   * track competes with the font preload for no benefit.
   */
  readonly isFirst: boolean;
}

const { artist, artistPhoto, title, kind, releaseDate, duration, artwork, unseenCount, isFirst } =
  Astro.props;

/** `Release.Kind` is capitalised for display by the Swift view; same here. */
const kindLabel = kind === 'ep' ? 'EP' : kind.charAt(0).toUpperCase() + kind.slice(1);

const formattedDate = new Intl.DateTimeFormat('en-GB', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
}).format(new Date(`${releaseDate}T00:00:00Z`));

const totalTime = `${Math.floor(duration / 60)}:${String(duration % 60).padStart(2, '0')}`;
---

<article class="card">
  <header class="head">
    <p class="kind"><span class="new">new</span> {kindLabel}</p>
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 11v5.5M12 7.8v.4" stroke-linecap="round"></path>
    </svg>
  </header>

  <Picture
    class="art"
    src={artwork}
    alt=""
    formats={['avif', 'webp']}
    widths={[260, 520]}
    sizes="260px"
    quality={72}
    loading={isFirst ? 'eager' : 'lazy'}
    fetchpriority={isFirst ? 'high' : 'auto'}
  />

  <p class="chip">
    {
      artistPhoto ? (
        <Image class="avatar" src={artistPhoto} alt="" width={44} height={44} />
      ) : (
        <span class="avatar" />
      )
    }
    {artist}
  </p>

  <h3 class="title">{title}</h3>

  <p class="date">
    <svg class="glyph sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <rect x="3.5" y="5" width="17" height="15" rx="2.5"></rect>
      <path d="M3.5 10h17M8.5 3v3M15.5 3v3" stroke-linecap="round"></path>
    </svg>
    {formattedDate}
  </p>

  <div class="scrub">
    <span class="track"><span class="knob"></span></span>
    <span class="times"><span>0:00</span><span>{totalTime}</span></span>
  </div>

  <div class="transport">
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path d="M4 7h16M4 12h16M4 17h10" stroke-linecap="round"></path>
    </svg>
    <svg class="glyph dim" viewBox="0 0 24 24" fill="currentColor">
      <path d="M18 5v14l-11-7zM6 5h2v14H6z"></path>
    </svg>
    <span class="play">
      <svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5.5v13l11-6.5z"></path></svg>
    </span>
    <svg class="glyph dim" viewBox="0 0 24 24" fill="currentColor">
      <path d="M6 5v14l11-7zM16 5h2v14h-2z"></path>
    </svg>
    <svg class="glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6">
      <path
        d="M12 20s-7.5-4.6-7.5-9.2A4.3 4.3 0 0 1 12 8a4.3 4.3 0 0 1 7.5 2.8C19.5 15.4 12 20 12 20z"
      ></path>
    </svg>
  </div>

  <footer class="bottom">
    {
      unseenCount === null ? (
        <p class="label">{catalogue(Astro.currentLocale).home.device.feedScreen.recommended}</p>
      ) : (
        <p class="label">{unseenCount} New Releases</p>
      )
    }
    <svg
      class="glyph chevron"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.8"
    >
      <path d="M6 9.5l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
  </footer>
</article>

<style>
  /*
   * Every size below is a fraction of the screen, matching ReleasePlayerCard's use of
   * geometry height. `cqh`/`cqw` resolve against Device.astro's screen container.
   */
  /*
   * The stack is centred, not top-aligned. This is the app's own behaviour rather than a
   * correction to it: `ReleasePlayerCard`'s VStack carries `.frame(minHeight: H)`, and
   * SwiftUI's default alignment for that is `.center` - so when the content is shorter
   * than the screen, which it always is, the app centres it. Building it top-aligned left
   * a band of empty screen under the transport row that the app does not have.
   */
  .card {
    flex: 0 0 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    /* topPad = max(safeTop + 20, H * 0.08) */
    padding: 8cqh 8cqw 5cqh;
    color: var(--color-white);
    /* The screen is a mockup, not a reading surface: it is aria-hidden and scaled far
     * below the site's own type sizes, so the site's fluid scale does not apply here. */
    font-size: 2cqh;
    line-height: 1.3;
  }

  .head {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 2.5cqh;
  }

  .kind {
    margin: 0;
    font-size: min(20px, 2.4cqh);
    font-weight: 400;
    color: rgba(250, 250, 250, 0.7);
  }
  .new {
    font-size: min(18px, 2.2cqh);
    font-weight: 600;
    color: var(--color-white);
  }

  .glyph {
    width: min(20px, 2.6cqh);
    height: min(20px, 2.6cqh);
    flex: none;
    color: var(--color-white);
  }
  .glyph.sm {
    width: min(14px, 1.9cqh);
    height: min(14px, 1.9cqh);
  }
  .glyph.dim {
    color: rgba(250, 250, 250, 0.45);
  }

  .art {
    width: 100%;
    aspect-ratio: 1;
    /* artSize = min(W - 64, H * 0.35) */
    max-height: 35cqh;
    object-fit: cover;
    border-radius: 3cqw;
    margin-bottom: 2.5cqh;
    background: var(--color-ink-800);
  }

  .chip {
    display: flex;
    align-items: center;
    gap: 1.6cqw;
    margin: 0 0 2cqh;
    padding: 0.7cqh 3cqw 0.7cqh 0.7cqh;
    border-radius: 999px;
    background: rgba(250, 250, 250, 0.08);
    font-size: min(15px, 1.9cqh);
    font-weight: 500;
    color: rgba(250, 250, 250, 0.85);
  }
  /*
   * The artist's picture, or a blank disc where the showcase has no photograph for them.
   * One rule for both: the disc is the same circle with the white showing through, so a
   * card that gains a photograph changes what is in the circle and nothing about the
   * chip's metrics.
   */
  .avatar {
    width: min(22px, 2.9cqh);
    height: min(22px, 2.9cqh);
    border-radius: 999px;
    background: var(--color-white);
    object-fit: cover;
    flex: none;
  }

  .title {
    margin: 0 0 1cqh;
    font-size: min(19px, 2.4cqh);
    font-weight: 700;
    letter-spacing: -0.01em;
    text-align: center;
    line-height: 1.2;
  }

  .date {
    display: flex;
    align-items: center;
    gap: 1.4cqw;
    margin: 0;
    font-size: min(15px, 1.9cqh);
    color: rgba(250, 250, 250, 0.7);
  }

  .scrub {
    width: 100%;
    margin-top: 3cqh;
  }
  .track {
    display: block;
    height: 0.35cqh;
    min-height: 2px;
    border-radius: 999px;
    background: rgba(250, 250, 250, 0.28);
    position: relative;
  }
  .knob {
    position: absolute;
    left: 0;
    top: 50%;
    width: min(11px, 1.4cqh);
    height: min(11px, 1.4cqh);
    border-radius: 999px;
    background: var(--color-white);
    transform: translate(-10%, -50%);
  }
  .times {
    display: flex;
    justify-content: space-between;
    margin-top: 1cqh;
    font-size: min(13px, 1.7cqh);
    color: rgba(250, 250, 250, 0.7);
    font-variant-numeric: tabular-nums;
  }

  .transport {
    width: 100%;
    margin-top: 2.5cqh;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  /* "one dominant white circular play control among lighter secondary icons" -
   * reference-study.md §4's reading of the app's established vocabulary. */
  .play {
    width: min(64px, 8.4cqh);
    height: min(64px, 8.4cqh);
    border-radius: 999px;
    background: var(--color-white);
    display: grid;
    place-items: center;
    flex: none;
  }
  .play svg {
    width: 45%;
    height: 45%;
    color: var(--color-ink-950);
  }

  /* botPad = max(safeBottom + 20, H * 0.05) - a fixed gap in the app, not a spacer that
   * pushes the bar to the floor. Using `margin-top: auto` here is what pinned the bottom
   * bar to the bottom edge and made everything above it read as top-heavy. */
  .bottom {
    margin-top: 5cqh;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4cqh;
  }
  /*
   * One colour for every state of this label, including "Recommended for You".
   *
   * **A deliberate divergence from the app** (owner, 2026-09-11). `ReleasePlayerCard.swift`
   * sets that one case in `SonaruColor.checkBg` - `rgb(140, 18, 87)`, a magenta - so the
   * discovery page reads as a different kind of content from the releases above it, and
   * this mirrored it. In the app the distinction earns its colour: the label is a live
   * control and the magenta says the next swipe leaves the chronological feed.
   *
   * On the site it is neither. The card is `aria-hidden` decoration, nothing is tappable,
   * and the site's own magenta is the CTA colour - so one pink line at the foot of the
   * phone reads as the page's accent leaking into the mockup rather than as the app's own
   * signal. It sits at `textSecondary` with the count label and the chevron, which is what
   * the rest of the footer is.
   *
   * Do not restore the magenta for app parity: `design-system.md` §6 asks these screens to
   * mirror the app's *structure and naming*, and this is the one place the reading differs.
   */
  .label {
    margin: 0;
    font-size: min(15px, 1.8cqh);
    font-weight: 500;
    color: rgba(250, 250, 250, 0.7);
  }
  .chevron {
    color: rgba(250, 250, 250, 0.7);
  }
</style>
