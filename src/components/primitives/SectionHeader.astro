---
/**
 * The header every act opens with: an eyebrow, a headline, and an optional lede.
 *
 * One <h2> per act, so the heading outline stays correct without each section having to
 * think about it (`acceptance-criteria.md` §7). The eyebrow is a <p>, not a heading -
 * it is a label, and promoting it to <h3> would put a phantom level in the outline.
 */
interface Props {
  readonly eyebrow?: string | undefined;
  readonly headline: string;
  readonly lede?: string | undefined;
  /** Applied to the <h2>, so a section can point `aria-labelledby` at it. */
  readonly id?: string | undefined;
  readonly class?: string | undefined;
}

const { eyebrow, headline, lede, id, class: className } = Astro.props;
---

<header class:list={['section-header', className]}>
  {eyebrow !== undefined && <p class="eyebrow">{eyebrow}</p>}
  <h2 id={id}>{headline}</h2>
  {lede !== undefined && <p class="lede">{lede}</p>}
</header>

<style>
  .section-header {
    display: flex;
    flex-direction: column;
    gap: var(--spacing-4);
  }

  .eyebrow {
    margin: 0;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-plum-300);
  }

  h2 {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: var(--leading-display);
    letter-spacing: var(--tracking-display);
    color: var(--color-white);
    max-width: var(--measure-tight);
    text-wrap: balance;
  }

  .lede {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-body);
    color: var(--color-mute-200);
    max-width: var(--measure);
  }
</style>
