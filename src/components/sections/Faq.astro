---
/**
 * The FAQ - phases.md 8.7, with the `FAQPage` structured data that section asks for.
 *
 * The list, its styles and its JSON-LD live in `FaqList.astro` since SEO audit H3, which
 * reuses them on the home page. This section is the pricing route's frame around it: the
 * header and the page padding.
 */
import SectionHeader from '../primitives/SectionHeader.astro';
import FaqList from '../primitives/FaqList.astro';
import { catalogue } from '../../i18n';

const t = catalogue(Astro.currentLocale);
const { entries: FAQ, eyebrow, headline } = t.pricing.faq;
---

<section class="faq" data-pricing-faq aria-labelledby="faq-title">
  <div class="inner">
    <SectionHeader eyebrow={eyebrow} headline={headline} id="faq-title" />

    <FaqList entries={FAQ} />
  </div>
</section>

<style>
  .faq {
    padding: 0 var(--gutter) var(--spacing-32);
  }

  .inner {
    max-width: var(--content-max);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: var(--spacing-12);
  }
</style>
