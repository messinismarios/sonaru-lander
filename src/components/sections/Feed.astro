      transform-origin: 50% 50%;
      transform: translateX(calc(var(--feed-aside) * var(--aside-x)))
        scale(calc(1 - var(--feed-aside) * (1 - var(--aside-scale))));
    }

    /*
     * The dates: a plain column down the left, laid out by index, never touched after
     * paint. All of them on the left rather than desktop's odd/even alternation between
     * two margins - there is only one margin here.
     */
    /*
     * Round 5 (owner): the column fades with the phone's own move rather than standing
     * through it. `--feed-aside` is already exactly that signal - 0 while the phone is
     * centred over where the dates sit, 1 once it is fully right, and back to 0 as it flips
     * back - so the dates are at full strength only while there is room for them, and the
     * overlap at both ends resolves itself.
     *
     * This is the one thing on the column that is driven: the dates' *positions* are still
     * plain CSS and still never touched, which is what "like a calendar" asked for.
     */
    .chronology {
      display: block;
      /*
       * Cubed, not the raw signal. Both the fade and the phone's move ride `--feed-aside`,
       * so a linear opacity has the dates already at 0.7 while the phone is still crossing
       * the space they occupy - which is the overlap this fade is here to remove. Cubing
       * holds them back until the phone is most of the way clear and still reaches exactly
       * 1 at the end of the move, which is what "opacity 1 when the phone is fully to the
       * right" asks for. Written out rather than eased in JS for the same reason
       * `--settle-ease` above is: the value has to be a pure function of the signal.
       */
      opacity: calc(var(--feed-aside) * var(--feed-aside) * var(--feed-aside));
      inset: 0;
    }

    /* Month over year, so the block is narrower than the phone's margin (owner, round 5). */
    .rest {
      display: grid;
      justify-items: end;
      gap: 2px;
      line-height: 1.15;
    }

    /*
     * Round 4 (owner): the column is **right-aligned against the phone**, not against the
     * screen - it sits at the right-hand edge of the whitespace the phone leaves, so the
     * dates touch it. `--phone-left` is derived from the same overhang fraction the phone
     * moves by, so the column tracks the phone rather than restating its position.
