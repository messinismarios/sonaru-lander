    .stamp,
    .stamp:nth-child(odd),
    .stamp:nth-child(even) {
      left: auto;
      right: calc(100vw - var(--phone-left) + var(--spacing-8));
      top: calc(var(--date-start) + var(--i) * var(--date-step));
      bottom: auto;
      width: auto;
      align-content: start;
      justify-items: end;
      text-align: right;
      /* Beats `renderStamps`' inline styles, which this branch never calls - the column is
       * static, so a stamp must not inherit the crossfade's hidden state. */
      opacity: 1 !important;
      transform: none !important;
      will-change: auto;
    }

    /*
     * The calendar rule (owner, round 3: "a vertical line between each date"). One segment
     * per gap rather than a single spine behind the whole column, so the line reads as
     * joining one date to the next rather than running behind the type. The last date has
     * none - there is nothing after it to join to.
     *
     * Its length is the step less the space the date itself occupies, and it fades at both
     * ends so it meets the type without butting into it.
     */
    .stamp:not(:last-child)::after {
      content: '';
      position: absolute;
      right: 0;
      top: calc(100% + var(--spacing-3));
      width: 1px;
      height: calc(var(--date-step) - var(--stamp-h) - var(--spacing-6));
      background: linear-gradient(
        to bottom,
        transparent,
        var(--color-mute-400) 12%,
        var(--color-mute-400) 88%,
        transparent
