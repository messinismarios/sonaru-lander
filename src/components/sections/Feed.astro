      --copy-gap-above: 44px;
      /* 0 since 8.14c round 7 (owner: closer to the playlist, whose own top padding is the
       * gap now). */
      --copy-gap-below: 0px;

      /* The scroll after the last date that belongs to the copy alone. The phone's own
       * bottom margin is this, which is what unpins it before the copy arrives. */
      --copy-zone: calc(var(--copy-gap-above) + var(--copy-h) + var(--copy-gap-below));

      /* What the headline and lede occupy at this width - measured, and only used to place
       * what sits after them. */
      --copy-h: 257px;

      /* The block the phone is sticky within: every date, then the copy's own room. Held at
       * exactly the length it had before the closing round moved the swipes earlier
       * (`50svh + 34svh + 2 * 62svh + 40svh`), so the scroll they gave up is the third
       * release's to keep. */
      --pin-h: calc(248svh + var(--copy-zone));
