      opacity: 0.5;
    }

    .day {
      /* "A lot smaller" (owner, round 2): this is a date in a column, not the decorative
       * anchor it is at 1440, where it fills half a pin. */
      font-size: var(--text-2xl);
      opacity: 0.55;
    }

    .rest {
      font-size: var(--text-xs);
    }

    /*
     * The copy: placed after the last date and simply scrolled to, with no fade and no
     * signal of its own (owner, round 2). It sits inside `.pin` but `.pin` is in normal
     * flow at this width, so "inside the pinned element" no longer means "pinned".
     */
    /*
     * The bloom (owner, round 3: the orbs are "way too small and spread out, similar to how
     * the hero section was which we fixed"). Same fix, same reasoning: the scale lands on
     * each `.orb` **in place**, never on the field around them - growing the parent moves
     * every orb further from centre, which is the opposite of bunching. `translate(-50%,
     * -50%)` is the orb's own base transform and has to be restated, since `transform` is
     * one property.
     *
     * Scoped through `.atmosphere`, so it cannot reach a `.orb` anywhere else on the site -
     * `BloomField` is shared with three frozen acts and is not touched here.
     */
    .atmosphere :global(.orb) {
      transform: translate(-50%, -50%) scale(2.2);
    }

    .copy {
      /* Below where the phone lets go, so the two never share a frame. */
      top: calc(var(--pin-h) - var(--copy-zone) + var(--copy-gap-above));
      bottom: auto;
      opacity: 1;
      transform: none;
      text-shadow: none;
      will-change: auto;
    }
  }
