    /* The budget lives in `.pin`'s own height now, not in spacers beside it. */
    .travel.shift,
    .travel.releases,
    .travel.rest,
    .travel.settle,
    .travel.outro-hold {
      height: 0;
    }

    .pin {
      position: relative;
      height: var(--pin-h);
      /* `clip`, never `hidden`: `hidden` establishes a scroll container and a sticky child
       * positions against its nearest scrollport, which would silently un-pin the phone.
       * The clip itself is load-bearing horizontally - 30% of the phone is outside. */
      overflow: clip;
      display: block;
    }

    .device-slot {
      /* The phone, and only the phone. It is in ordinary flow until its top reaches the
       * offset that centres it, and pins itself there - never sticky from the start. */
      position: sticky;
      top: calc((100svh - var(--mobile-device-h)) / 2);
      left: auto;
      height: var(--mobile-device-h);
      margin-inline: auto;
