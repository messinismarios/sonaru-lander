---
/**
 * `/press` - the press kit. phases.md 8.10b.
 *
 * **A kit, not a newsroom, and that is the unit's whole finding.** Gate A probed all four
 * references: superlist.com has no press page, no brand page and no about page - every one
 * 404s; gsap.com has no `/press` either, only a `/brand` docs page whose single download is
 * a zip; and the two that *do* ship one, cash.app and revolut.com, ship a **news list**
 * with the kit as a footnote at the bottom. Sonaru has no news - it has not launched - so
 * the footnote is promoted to the page and the news list is refused outright. `/changelog`
 * is product releases and 8.9e owns it; putting it here would make the largest element on
 * the page the one thing on it that is not press.
 *
 * **What is deliberately absent:** cash.app's three stat tiles (5★ Editor's Choice, 9.9m+
 * reviews, 4.5★ Trustpilot) are the strongest thing on their page and **we cannot honestly
 * fill one**. A pre-launch product has no rating, no review count and no install number,
 * and inventing them is the only move available on this page that could actually mislead
 * somebody in print.
 *
 * `Document.astro` unforked - the fourth route to reuse it, after the legal documents, the
 * changelog and the blog article. No new layout, no new token. The blocks that are wider
 * than prose use `--measure-wide`, which is the width `PostFigure` already established for
 * things that are not prose.
 *
 * The assets are generated by `npm run press` and committed; `src/data/press.ts` declares
 * what is offered and `public/press/manifest.json` supplies every size printed below, so
 * no weight on this page is typed by hand.
 */
import Document from '../../layouts/Document.astro';
import Button from '../../components/primitives/Button.astro';
import CopyBlock from '../../components/press/CopyBlock.astro';
import {
  BOILERPLATE,
  COLOURWAYS,
  KIT_FILE,
  PRESS_EMAIL,
  SCREENS,
  SWATCHES,
} from '../../data/press';
import manifest from '../../../public/press/manifest.json';
import brandPdf from '../../../public/brand/manifest.json';
import tokensCss from '../../styles/tokens.css?raw';
import { fileWeight } from '../../lib/bytes';
import { colour } from '../../lib/tokens';
import { catalogue } from '../../i18n';
import type { GetStaticPaths } from 'astro';
import { localePaths } from '../../i18n/routing';

/*
 * The route in both locales from one file - phases.md 8.11b. `undefined` is the default
 * locale, which is what leaves it unprefixed.
 */
export const getStaticPaths = (() => localePaths()) satisfies GetStaticPaths;

const t = catalogue(Astro.currentLocale);
const copy = t.press;

const files: Record<string, { bytes: number; width?: number; height?: number }> = manifest.files;

/**
 * A file's size, the way a download should state it.
 *
 * Every number on this page is read from the manifest the generator wrote. A hand-typed
 * "~1 MB" is right until the day it is not, and nothing would fail when it stopped being
 * true - the same class of defect as the OG card that went stale in somebody's timeline.
 *
 * The rounding itself moved to `src/lib/bytes.ts` at 8.10d, when `/brand` became the
 * second page to offer a file. What stays here is the lookup: a file this page offers and
 * the manifest has never heard of is a broken download, and it should fail the build
 * rather than print `undefined`.
 */
function weight(file: string): string {
  const bytes = files[file]?.bytes;
  if (bytes === undefined)
    throw new Error(`public/press/${file} is offered but not in the manifest`);
  return fileWeight(bytes);
}

/**
 * The swatches, with their values resolved.
 *
 * `src/data/press.ts` names the tokens and this reads them, so no hex is typed anywhere
 * outside `tokens.css` - `CLAUDE.md`'s first non-negotiable - and a token that disappears
 * from the palette fails the build rather than printing a wrong colour to a journalist.
 */
const swatches = SWATCHES.map((swatch) => ({
  ...swatch,
  role: copy.colour.roles[swatch.token],
  name: `--color-${swatch.token}`,
  hex: colour(tokensCss, swatch.token),
}));

/** `Mark, SVG` plus its weight - a download that says what it costs before it is clicked. */
function fileLabel(label: keyof typeof copy.logo.files, file: string): string {
  return `${copy.logo.files[label]} · ${weight(file)}`;
}
---

<Document
  title={copy.title}
  metaTitle={t.ui.meta.press.title}
  eyebrow={copy.eyebrow}
  description={t.ui.meta.press.description}
  lede={copy.lede}
>
  <p class="kit">
    <Button href={`/press/${KIT_FILE}`}>
      {copy.kitDownload.replace('{weight}', weight(KIT_FILE))}
    </Button>
  </p>

  <h2 id="boilerplate">{copy.boilerplate.heading}</h2>
  <p>{copy.boilerplate.intro}</p>

  {
    BOILERPLATE.map((entry) => (
      <CopyBlock
        class="quote"
        value={copy.boilerplate.entries[entry.id].text}
        label={copy.boilerplate.copyLabel.replace(
          '{length}',
          copy.boilerplate.entries[entry.id].label.toLowerCase(),
        )}
      >
        <p class="quote-label">{copy.boilerplate.entries[entry.id].label}</p>
        <p class="quote-text">{copy.boilerplate.entries[entry.id].text}</p>
      </CopyBlock>
    ))
  }

  <h2 id="logo">{copy.logo.heading}</h2>
  <p>{copy.logo.intro}</p>

  <div class="ways">
    {
      COLOURWAYS.map((way) => (
        <section class="way" data-way={way.id} aria-labelledby={`way-${way.id}`}>
          <h3 id={`way-${way.id}`}>{copy.logo.ways[way.id].label}</h3>
          <p class="way-note">{copy.logo.ways[way.id].note}</p>
          <div class="preview">
            <img
              src={`/press/sonaru-lockup${way.id === 'light' ? '-light' : ''}-1024.png`}
              alt=""
              width={files[`sonaru-lockup${way.id === 'light' ? '-light' : ''}-1024.png`]?.width}
              height={files[`sonaru-lockup${way.id === 'light' ? '-light' : ''}-1024.png`]?.height}
              loading="lazy"
            />
          </div>
          <ul class="files">
            {way.files.map((file) => (
              <li>
                <a href={`/press/${file.file}`} download>
                  {fileLabel(file.label, file.file)}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>
  <p class="aside">{copy.logo.aside}</p>

  {
    /*
    The identity document, offered where someone looking for a file already is - 8.10d.

    Not in `sonaru-press-kit.zip`. The kit is what a journalist needs to lay out a piece:
    marks, colourways, screenshots. A 22-page document about clear space and voice is a
    different errand, and putting it in the zip makes every kit download twice the size to
    carry something most of them will never open.
  */
  }
  {
    /*
      **The explicit `{' '}` between every expression and its neighbour is load-bearing**,
      and rebuilding this sentence out of catalogue keys is what exposed a defect in the
      one below it. `/press` has rendered `the app,/support` - comma fused to the link,
      no space - since 8.10b, through a Gate C approval and every run of the suite since.
      `tests/visual/inline-spacing.spec.ts` exists for exactly this and did not see it:
      its rule looks for a *letter* beside the inline element, and a comma is not one.
      The extraction fixed it by giving the space somewhere to live, which moves an
      approved page by 6px - disclosed at 8.11a's Gate C rather than shipped quietly.
      Astro drops the whitespace around a `{...}` expression, so once 8.11a moved this
      sentence's fragments into the catalogue the words fused to the links between them -
      `…identity itself?The brand document…covers construction…`. It was caught by
      `tests/visual/inline-spacing.spec.ts`, which exists for exactly this and was named
      as this unit's likeliest regression at Gate B. Same fix as 8.1's.
    */
  }
  <p class="brand-doc">
    {copy.brandDoc.before}{' '}
    <a href={`/brand/${brandPdf.file}`} download>
      {
        copy.brandDoc.docLink
          .replace('{weight}', fileWeight(brandPdf.bytes))
          .replace('{pages}', String(brandPdf.pages))
      }
    </a>{' '}
    {copy.brandDoc.middle}{' '}
    <a href="/brand">{copy.brandDoc.pageLink}</a>{' '}
    {copy.brandDoc.after}
  </p>

  <h2 id="colour">{copy.colour.heading}</h2>
  <p>{copy.colour.intro}</p>

  <ul class="swatches">
    {
      swatches.map((swatch) => (
        <li>
          <CopyBlock
            value={swatch.hex}
            label={copy.colour.copyLabel
              .replace('{hex}', swatch.hex)
              .replace('{role}', swatch.role)}
          >
            <span class="chip" style={`background:${swatch.hex}`} aria-hidden="true" />
            <span class="swatch-hex">{swatch.hex}</span>
            <span class="swatch-role">
              {swatch.role}
              <span class="swatch-token">{swatch.name}</span>
            </span>
          </CopyBlock>
        </li>
      ))
    }
  </ul>

  <h2 id="screenshots">{copy.screenshots.heading}</h2>
  <p>{copy.screenshots.intro}</p>

  <ul class="screens">
    {
      SCREENS.map((screen) => (
        <li>
          <figure>
            <a href={`/press/screens/${screen.id}-full.jpg`}>
              <img
                src={`/press/screens/${screen.id}.jpg`}
                alt={copy.screenshots.screens[screen.id].alt}
                width={files[`screens/${screen.id}.jpg`]?.width}
                height={files[`screens/${screen.id}.jpg`]?.height}
                loading="lazy"
              />
            </a>
            <figcaption>
              {copy.screenshots.screens[screen.id].title}{' '}
              <span class="screen-weight">{weight(`screens/${screen.id}-full.jpg`)}</span>
            </figcaption>
          </figure>
        </li>
      ))
    }
  </ul>

  <h2 id="contact">{copy.contact.heading}</h2>
  <p>
    {copy.contact.before}{' '}
    <a href={`mailto:${PRESS_EMAIL}`}>{PRESS_EMAIL}</a>{copy.contact.middle}{' '}
    <a href="/support">/support</a>{' '}
    {copy.contact.after}
  </p>
</Document>

<style>
  .kit {
    margin: 0 0 var(--spacing-12);
  }

  /*
   * Wider than prose - `PostFigure`'s idea, that the site has one width for things that
   * are not prose, with its `100vw` term removed.
   *
   * **The breakout is a negative margin bounded by the page's own gutter, and it is
   * deliberately not a viewport unit.** `100vw` is the viewport *including* a classic
   * scrollbar and the page's usable width is not, so `calc(100vw - 2 * var(--gutter))` is
   * about 15px too wide wherever scrollbars take space - the horizontal scroll the owner
   * reported at Gate C. `100%` here is the reading column, which is already sized from the
   * real client width, so the block grows symmetrically out of it by at most one gutter on
   * each side and stops at the edge of the page's text area.
   *
   * **Symmetrically is the whole of it.** The first version of this fix set
   * `width: calc(100% + 2 * var(--gutter))` and left the block where it started - which
   * grows the *right* edge by two gutters and put 24px of the swatches off the side of a
   * 320px phone. `tests/e2e/no-horizontal-scroll.spec.ts` failed on it immediately, which
   * is the only reason it is not in this commit.
   *
   * The measurable trade: at 1440 these blocks are 748px rather than `--measure-wide`'s
   * 820px. Below about 870px - where the old expression's `100vw` term was the binding one,
   * and the one that overflowed - the two agree to the pixel.
   */
  .ways,
  .swatches,
  .screens {
    --breakout: max(0px, min(var(--gutter), calc((var(--measure-wide) - 100%) / 2)));
  }

  /*
   * No breakout below `md` (owner, 8.14): on a phone the reading column is already the page
   * less its gutters, so "one gutter wider" meant flush to the edge of the screen - the
   * swatches and screenshots touched both sides while the prose around them did not.
   * `tests/e2e/mobile-gutters.spec.ts` holds the gutter.
   */
  @media (max-width: 767px) {
    .ways,
    .swatches,
    .screens {
      --breakout: 0px;
    }
  }

  .quote {
    margin: 0 0 var(--spacing-8);
    padding: var(--spacing-6);
    border: 1px solid var(--color-ink-700);
    border-radius: 12px;
    background: var(--color-ink-900);
  }

  .quote-label {
    margin: 0 0 var(--spacing-2);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute-400);
  }

  .quote-text {
    margin: 0;
    color: var(--color-white);
  }

  .ways {
    display: grid;
    gap: var(--spacing-6);
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin: 0 calc(-1 * var(--breakout)) var(--spacing-6);
  }

  .way {
    padding: var(--spacing-6);
    border: 1px solid var(--color-ink-700);
    border-radius: 12px;
  }

  .way h3 {
    margin: 0;
    font-size: var(--text-lg);
    font-weight: 600;
    color: var(--color-white);
  }

  .way-note {
    margin: var(--spacing-2) 0 var(--spacing-4);
    font-size: var(--text-sm);
    color: var(--color-mute-400);
  }

  /*
   * The preview tile carries the ground each colourway is *for*. A logo file shown on the
   * page's own near-black tells a journalist nothing about the one they will put on white,
   * which is the mistake that makes an "on light" variant look wrong when they use it.
   */
  .preview {
    display: grid;
    place-items: center;
    padding: var(--spacing-6);
    border-radius: 8px;
  }

  .way[data-way='dark'] .preview {
    background: var(--color-ink-950);
  }

  .way[data-way='light'] .preview {
    background: var(--color-white);
  }

  .preview img {
    width: 100%;
    height: auto;
    max-width: 220px;
  }

  /*
   * `ul.files` rather than `.files`, and `> li` spelled out - `changelog.astro`'s note
   * applies here word for word. Astro scopes with `:where()`, which preserves author
   * specificity, so a bare class sits at 0-1-0 and loses to `.prose :global(ul)` at
   * 0-1-1: the first render of this page had discs and a 24px indent on every list on it.
   * Matched on specificity deliberately rather than with `!important`.
   */
  ul.files {
    list-style: none;
    margin: var(--spacing-4) 0 0;
    padding: 0;
    font-size: var(--text-sm);
  }

  ul.files > li {
    margin-bottom: 0;
  }

  ul.files > li + li {
    margin-top: var(--spacing-2);
  }

  ul.swatches {
    list-style: none;
    display: grid;
    gap: var(--spacing-4);
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin: 0 calc(-1 * var(--breakout)) var(--spacing-6);
    padding: 0;
  }

  .swatches :global(.copy) {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: var(--spacing-2) var(--spacing-3);
  }

  .chip {
    grid-row: span 2;
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-ink-700);
    border-radius: 8px;
  }

  .swatch-hex {
    font-size: var(--text-sm);
    color: var(--color-white);
  }

  .swatch-role {
    font-size: var(--text-sm);
    color: var(--color-mute-400);
  }

  /*
   * The token name, for the half of this site's audience that reads the source
   * (`mission.md` §2). A journalist needs the hex; an engineer looking at how the palette
   * is organised gets the name it has in `tokens.css`, which is the same thing this page
   * read it out of.
   */
  .swatch-token {
    display: block;
    font-size: var(--text-xs);
    /*
     * `--mute-400`, the validated colour for meta text - not a dimmer grey. The first
     * version of this line used `--ink-700`, which `check-contrast.mjs` declares as a
     * *decorative divider with no minimum* and which measures about 1.2:1 against the
     * ground: invisible, and invisible in a way the contrast gate does not fail, because
     * it never scores a pairing nobody said was text. 8.9a's footer made the same mistake
     * with an opacity and the note is in `CLAUDE.md`.
     */
    color: var(--color-mute-400);
  }

  /* The button belongs under the pair, not beside the chip. */
  .swatches :global(.tools) {
    grid-column: 1 / -1;
    margin-top: 0;
  }

  /*
   * Five phones, and the track size is chosen so they land in one row rather than four and
   * an orphan: at `--measure-wide` (820px) a 150px minimum yields four tracks and leaves
   * the fifth screen alone on a second line, which reads as a mistake rather than a set.
   * 130px yields five. At 390 it falls to two per row on its own.
   */
  ul.screens {
    list-style: none;
    display: grid;
    gap: var(--spacing-6);
    grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
    margin: 0 calc(-1 * var(--breakout)) var(--spacing-6);
    padding: 0;
  }

  ul.swatches > li,
  ul.screens > li {
    margin-bottom: 0;
  }

  .screens figure {
    margin: 0;
  }

  .screens img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-ink-700);
    border-radius: 12px;
  }

  .screens figcaption {
    margin-top: var(--spacing-2);
    font-size: var(--text-sm);
    color: var(--color-mute-200);
  }

  /*
   * The weight on its own line, so five captions of different lengths give the row one
   * baseline instead of four one-liners and one that wrapped.
   */
  .screen-weight {
    display: block;
    color: var(--color-mute-400);
  }

  .aside {
    font-size: var(--text-sm);
    color: var(--color-mute-400);
  }
</style>
