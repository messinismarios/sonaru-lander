{
  "name": "sonaru-frontend-lander",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing site for Sonaru - sonaru.app",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:host": "astro dev --host",
    "stop": "astro dev stop",
    "build": "astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "contrast": "node --experimental-strip-types scripts/check-contrast.mjs",
    "check:production": "node scripts/check-production.mjs",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run contrast && npm run build && npm test",
    "fonts": "node scripts/build-fonts.mjs",
    "test": "playwright test",
    "brand": "node --experimental-strip-types scripts/build-brand-assets.mjs",
    "og": "node scripts/build-og-images.mjs",
    "press": "node --experimental-strip-types scripts/build-press-assets.mjs",
    "showcase": "node scripts/build-showcase.mjs",
    "baselines:diff": "node scripts/diff-baselines.mjs",
    "pdf": "node --experimental-strip-types scripts/build-brand-pdf.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "7.0.8",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.2.9",
    "gsap": "3.15.0",
    "lenis": "1.3.26",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/svelte": "9.0.1",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.4.0",
    "eslint": "10.9.1",
    "eslint-plugin-astro": "3.1.0",
    "eslint-plugin-svelte": "3.23.0",
    "fontkit": "2.0.4",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-svelte": "4.1.1",
    "subset-font": "2.7.0",
    "svelte": "5.57.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0"
  }
}
